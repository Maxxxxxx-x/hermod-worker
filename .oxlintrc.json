{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc"],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-console": "off",
        "eqeqeq": "error"
    },
    "env": {
        "builtin": true
    },
    "ignorePatterns": ["dist/**", "node_modules/**", ".wrangler/**"]
}

