{
    "pre-commit": {
        "commands": {
            "oxfmt": {
                "glob": "*.{ts,json}",
                "run": "bun run oxfmt {staged_files} && git add {staged_files}"
            },
            "oxlint": {
                "glob": "*.ts",
                "run": "bun run oxlint {staged_files}"
            }
        }
    },
    "pre-push": {
        "commands": {
            "test": {
                "glob": "*.ts",
                "run": "bun test --pass-with-no-tests"
            }
        }
    }
}
